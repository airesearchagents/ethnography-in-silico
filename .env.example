# Copy to .env.local (gitignored), fill in the keys you have, then load it into
# your shell before running:  set -a; source .env.local; set +a
# Never commit real keys.

# --- Researcher agent (always needed: observer, field noter and debriefer run on Gemini Pro) ---
GOOGLE_API_KEY=

# --- Team model ---
# One of: gemini_pro, gemini_flash, claude, openai, deepseek, groq, ollama
TMT_PROVIDER=gemini_pro
# Override a single role, e.g. TMT_PROVIDER_CTO=claude
# TMT_PROVIDER_CTO=

# --- Provider keys (only those you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# --- Local open-weight models through Ollama ---
# TMT_OLLAMA_BASE=http://localhost:11434
# TMT_OLLAMA_MODEL=ollama_chat/qwen3.5:9b

# --- Gemini through Vertex AI, and grounded runs (--rag) ---
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# Retrieval region for --rag: a region, not global, whose RAG Engine tier you have checked.
RAG_LOCATION=
